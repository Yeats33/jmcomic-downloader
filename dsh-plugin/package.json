{
  "name": "@local/dsh-jmcomic",
  "version": "0.1.1",
  "description": "JMComic integration for DeepSeek Harness",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22", "dsh": "0.2.2-rc.1" },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "typert.js", "core", "cover", "download", "online-reader", "tests", "integration", "cordis.patch.yml", "locale", "icon.svg", "README.md", "LICENSE"],
  "scripts": { "test": "node --test tests/*.test.js cover/*.test.mjs download/*.test.mjs online-reader/*.test.mjs" },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "~3.19.0",
    "sharp": "^0.34.4",
    "zod": "4.4.3"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-sidebar", "@deepseek-ai/dsh-client-ui-layout"]
    }
  }
}
